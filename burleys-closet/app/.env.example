# Supabase — project "burleys-closet" (ref ffwgofycnfbtnfpwcdle)
NEXT_PUBLIC_SUPABASE_URL=https://ffwgofycnfbtnfpwcdle.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_6Z6NuH6Y9K58_3EUjA629g_LfGMWAL_
# Secret key: Supabase dashboard > Project Settings > API keys > service_role.
# Put it ONLY in .env.local (gitignored) and in Vercel env vars — never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# App password gate (set in prod; leave empty to disable locally)
APP_PASSWORD=

# eBay — developer.ebay.com keyset. Set the RuName's "auth accepted URL" to
# https://<your-app>/api/ebay/callback . Start with sandbox, flip to production.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_ENV=sandbox

# Claude API — AI listing drafts (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret for the Chrome extension + Poshmark sale webhook.
# Generate: openssl rand -hex 24
BRIDGE_SECRET=
POSHMARK_WEBHOOK_SECRET=

# Vercel cron protection (Vercel sets this header automatically when defined)
CRON_SECRET=
